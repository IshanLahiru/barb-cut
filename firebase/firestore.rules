rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ====== USERS ======
    match /users/{userId} {
      match /favourites/{favId} {
        allow read, write: if isOwner(userId);
      }
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId) && 
                       (request.resource.data.points == null || request.resource.data.points == 0);
      allow update: if (isOwner(userId) || isAdmin()) && 
                       (request.resource.data.points == resource.data.points) &&
                       (request.resource.data.uid == resource.data.uid) &&
                       (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    // ====== HAIRCUTS & BEARD STYLES ======
    match /haircuts/{haircutId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /beard_styles/{beardStyleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ====== AI JOBS (Parent Jobs) ======
    match /aiJobs/{parentJobId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId) || isAdmin();
      allow create, update, delete: if isAdmin();

      // ====== CHILD JOBS ======
      match /childJobs/{childJobId} {
        allow read: if isAuthenticated() && 
                       isOwner(get(/databases/$(database)/documents/aiJobs/$(parentJobId)).data.userId) 
                       || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // ====== HISTORY (Completed Jobs Archive) ======
    match /history/{historyDoc} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ====== USER PHOTOS ======
    match /userPhotos/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ====== PROFILE & CONFIG ======
    match /profile/{profileDoc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tabCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /styles/{styleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ====== ANALYTICS & MIGRATIONS ======
    match /analytics/{analyticsDoc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /_migrations/{migrationDoc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ====== CATCH-ALL (Deny all unmatched) ======
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
